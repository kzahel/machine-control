#!/usr/bin/env python3
"""Dependency-light portable and target-native repository checks."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]


def run(label: str, command: list[str], cwd: Path = ROOT) -> None:
    print(f"\n== {label} ==", flush=True)
    environment = {
        **os.environ,
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHON": sys.executable,
    }
    # Fixture claims and common CLI calls must not pollute operator history.
    with tempfile.TemporaryDirectory(prefix="machine-control-check-audit-") as audit:
        environment["MACHINE_CONTROL_AUDIT_DIR"] = str(Path(audit) / "history")
        environment["MACHINE_CONTROL_PROVISION_DIR"] = str(Path(audit) / "provisioning")
        environment.pop("MACHINE_CONTROL_PROVISION_RUN", None)
        completed = subprocess.run(command, cwd=cwd, env=environment, check=False)
    if completed.returncode != 0:
        raise SystemExit(completed.returncode)


def tracked_files() -> list[Path]:
    if in_git_checkout():
        completed = subprocess.run(
            ["git", "ls-files", "-z"],
            cwd=ROOT,
            capture_output=True,
            check=True,
        )
        return [
            ROOT / value.decode("utf-8")
            for value in completed.stdout.split(b"\0")
            if value
        ]

    ignored = {".build", ".git", "__pycache__", "node_modules", "obj"}
    files: list[Path] = []
    for path in ROOT.rglob("*"):
        relative = path.relative_to(ROOT)
        if any(part in ignored for part in relative.parts):
            continue
        if relative.parts[:2] == ("src", "bin") or (
            relative.parts
            and relative.parts[0] == "src"
            and "bin" in relative.parts[1:]
        ):
            continue
        if path.is_file():
            files.append(path)
    return sorted(files)


def in_git_checkout() -> bool:
    if shutil.which("git") is None:
        return False
    completed = subprocess.run(
        ["git", "rev-parse", "--is-inside-work-tree"],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    return completed.returncode == 0 and completed.stdout.strip() == "true"


def validate_json() -> None:
    print("\n== tracked JSON ==", flush=True)
    count = 0
    for path in tracked_files():
        if path.suffix == ".json":
            json.loads(path.read_text(encoding="utf-8"))
            count += 1
    print(f"validated {count} JSON files")


def validate_shell() -> None:
    bash = shutil.which("bash")
    if bash is None:
        print("\n== tracked Bash syntax ==\nskip: bash is unavailable")
        return
    scripts: list[Path] = []
    for path in tracked_files():
        if not path.is_file():
            continue
        if path.suffix == ".sh":
            scripts.append(path)
            continue
        try:
            with path.open(encoding="utf-8") as source:
                first_line = source.readline()
        except (OSError, UnicodeDecodeError):
            continue
        if "bash" in first_line:
            scripts.append(path)
    print(f"\n== tracked Bash syntax ({len(scripts)} files) ==", flush=True)
    for path in scripts:
        completed = subprocess.run([bash, "-n", str(path)], check=False)
        if completed.returncode != 0:
            raise SystemExit(completed.returncode)


def portable_checks() -> None:
    suites = [
        ("repository check runner", ROOT, ROOT / "tests" / "check"),
        ("common coordinator", ROOT, ROOT / "tests" / "client"),
        ("desktop update mailbox", ROOT, ROOT / "tests" / "desktop"),
        ("shared ADB", ROOT, ROOT / "providers" / "adb" / "tests"),
        ("UTM diagnostics", ROOT, ROOT / "providers" / "utm" / "tests"),
        (
            "target-use claims",
            ROOT,
            ROOT / "providers" / "claims" / "tests",
        ),
        (
            "workspace receipts",
            ROOT,
            ROOT / "providers" / "workspaces" / "tests",
        ),
        (
            "libvirt Linux provider",
            ROOT,
            ROOT / "providers" / "libvirt-linux" / "tests",
        ),
        ("Windows factory stages", ROOT, ROOT / "platforms" / "windows" / "tests"),
        ("Linux factory and credentials", ROOT, ROOT / "platforms" / "linux" / "tests"),
        (
            "Android dependency-free",
            ROOT / "platforms" / "android",
            ROOT / "platforms" / "android" / "tests",
        ),
        (
            "ChromeOS dependency-free",
            ROOT / "platforms" / "chromeos",
            ROOT / "platforms" / "chromeos" / "tests",
        ),
        (
            "iOS dependency-free",
            ROOT / "platforms" / "ios",
            ROOT / "platforms" / "ios" / "tests",
        ),
        (
            "Quest dependency-free",
            ROOT / "platforms" / "quest",
            ROOT / "platforms" / "quest" / "tests",
        ),
        (
            "Steam Deck dependency-free",
            ROOT / "platforms" / "steamdeck",
            ROOT / "platforms" / "steamdeck" / "tests",
        ),
    ]
    for label, cwd, tests in suites:
        run(
            label,
            [
                sys.executable,
                "-m",
                "unittest",
                "discover",
                "-s",
                str(tests),
                "-v",
            ],
            cwd,
        )
    validate_json()
    validate_shell()
    node = shutil.which("node")
    if node:
        run("browser indicator lifecycle", [node, "--test", "tests/browser/indicators.test.mjs", "tests/browser/worker.test.mjs"])
    else:
        print("\n== browser indicator lifecycle ==\nskip: Node.js is unavailable")
    if in_git_checkout():
        run("working-tree whitespace", ["git", "diff", "--check"])
    else:
        print("\n== working-tree whitespace ==\nskip: source archive has no Git metadata")


def native_checks() -> None:
    system = platform.system().lower()
    if system == "darwin":
        run(
            "macOS native static",
            ["bash", "tests/smoke.sh", "--static"],
            ROOT / "platforms" / "macos",
        )
        return
    if system == "linux":
        run(
            "Linux native static",
            ["bash", "tests/static.sh"],
            ROOT / "platforms" / "linux",
        )
        return
    if system == "windows":
        powershell = shutil.which("pwsh") or shutil.which("powershell.exe")
        if powershell is None:
            raise SystemExit("PowerShell is required for Windows native checks")
        run(
            "Windows native static and build",
            [
                powershell,
                "-NoLogo",
                "-NoProfile",
                "-NonInteractive",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                str(ROOT / "tests" / "windows" / "static.ps1"),
            ],
        )
        return
    raise SystemExit(f"unsupported native-check platform: {system}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--portable", action="store_true")
    parser.add_argument("--native", action="store_true")
    args = parser.parse_args()
    portable = args.portable or not (args.portable or args.native)
    native = args.native or not (args.portable or args.native)
    if portable:
        portable_checks()
    if native:
        native_checks()
    print("\nall requested checks passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
