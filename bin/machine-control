#!/usr/bin/env python3

import os
from pathlib import Path
import sys

repository = Path(__file__).resolve().parents[1]
if (repository / "client-runtime.json").is_file():
    # An installed copy lives inside a signed application bundle. Bytecode
    # written there (by whatever Python runs this file) breaks the code seal.
    os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
    sys.dont_write_bytecode = True
sys.path.insert(0, str(repository / "client"))

from machine_control import main  # noqa: E402

raise SystemExit(main())
