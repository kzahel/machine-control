{
  "mainBinaryName": "machine-control",
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "native/linux-runtime/": "linux-runtime/"
    },
    "linux": {
      "deb": {
        "depends": [
          "wl-clipboard",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "python3",
          "python3-gi",
          "gir1.2-gtk-3.0",
          "gir1.2-atspi-2.0",
          "gir1.2-gst-plugins-base-1.0",
          "gstreamer1.0-pipewire",
          "gstreamer1.0-plugins-good",
          "xdg-desktop-portal",
          "xdg-desktop-portal-gnome"
        ],
        "files": {
          "/usr/share/machine-control/mc-cli": "native/mc-cli/"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/machine-control/mc-cli": "native/mc-cli/"
        }
      }
    }
  }
}
