{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "native/mc-cli/": "mc-cli/",
      "../native/windows-README.txt": "README.txt",
      "native/runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "../native/windows-installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "machine-control",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Machine Control",
        "width": 640,
        "height": 440,
        "minWidth": 580,
        "minHeight": 400,
        "create": false
      }
    ]
  }
}
