{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machine-control-admission-channel-v1.schema.json",
  "title": "Live owner-bound desktop admission channel",
  "oneOf": [
    {
      "$ref": "#/$defs/open"
    },
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/reply"
    }
  ],
  "$defs": {
    "open": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "requestId",
        "scopes",
        "reason",
        "waitSeconds",
        "durationSeconds"
      ],
      "properties": {
        "schema": {
          "const": "machine-control-admission/v1"
        },
        "operation": {
          "const": "control.open"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "observe",
              "control",
              "browser",
              "devtools"
            ]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "claimId": {
          "type": "string",
          "maxLength": 80
        },
        "requestSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "outerRecovery": {
          "$ref": "outer-borrow-v1.schema.json"
        },
        "desktopDelegation": {
          "$ref": "desktop-delegation-v1.schema.json"
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "outerRecovery",
              "desktopDelegation"
            ]
          }
        }
      ]
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "requestId"
          ],
          "properties": {
            "operation": {
              "enum": [
                "control.status",
                "control.heartbeat",
                "control.cancel"
              ]
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "requestSequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "requestId",
            "offerGeneration"
          ],
          "properties": {
            "operation": {
              "enum": [
                "control.accept"
              ]
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "offerGeneration": {
              "type": "integer",
              "minimum": 1
            },
            "requestSequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "requestId",
            "sessionId",
            "resourceGenerations",
            "request"
          ],
          "properties": {
            "operation": {
              "enum": [
                "control.dispatch"
              ]
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "resourceGenerations": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 8,
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "request": {
              "type": "object",
              "required": [
                "operation"
              ],
              "properties": {
                "operation": {
                  "type": "string",
                  "minLength": 1
                },
                "requestSequence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                }
              }
            },
            "requestSequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        }
      ]
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "requestId",
        "accepted"
      ],
      "properties": {
        "schema": {
          "const": "machine-control-admission-channel/v1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "accepted": {
          "type": "boolean"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "data": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accepted": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "errorCode"
            ],
            "properties": {
              "errorCode": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
