{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machine-control.invalid/contracts/request-v0.schema.json",
  "title": "Machine Control Request v0",
  "type": "object",
  "required": ["operation"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "scope": { "type": "string" },
    "target": { "type": "string" },
    "applicationId": { "type": "string" },
    "arguments": { "type": "string" },
    "query": { "type": "string" },
    "reference": { "type": "string" },
    "action": { "type": "string" },
    "processId": { "type": "integer", "minimum": 0 },
    "windowId": { "type": "integer", "minimum": 0 },
    "maxDepth": { "type": "integer", "minimum": 0 },
    "maxElements": { "type": "integer", "minimum": 1 },
    "projection": { "enum": ["full", "compact"] },
    "knownSnapshotDigest": { "type": "string" },
    "timeoutMs": { "type": "integer", "minimum": 0 },
    "x": { "type": "integer" },
    "y": { "type": "integer" },
    "key": { "type": "string" },
    "text": { "type": "string" },
    "button": { "type": "string" },
    "state": { "type": "string" },
    "deliveryMode": { "enum": ["background", "foreground"] },
    "expectedGeneration": { "type": "string" },
    "allowVisualFallback": { "type": "boolean" }
  },
  "additionalProperties": true
}
