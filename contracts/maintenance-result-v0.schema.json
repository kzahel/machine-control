{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machine-control.invalid/contracts/maintenance-result-v0.schema.json",
  "title": "Machine Control Maintenance Result v0",
  "type": "object",
  "required": ["schema", "operation", "accepted", "target", "adapter", "data"],
  "properties": {
    "schema": { "const": "machine-control-maintenance/v0" },
    "operation": {
      "enum": ["maintenance.audit", "maintenance.repair", "maintenance.certify"]
    },
    "accepted": { "type": "boolean" },
    "target": { "type": "object" },
    "adapter": { "type": "object" },
    "data": {
      "type": "object",
      "required": ["profile", "healthy", "platformResultSchema"],
      "properties": {
        "profile": { "enum": ["runtime", "development"] },
        "healthy": { "type": "boolean" },
        "platformResultSchema": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "reboot": { "type": "object" },
        "checks": { "type": "array" },
        "repairs": { "type": "array" },
        "readiness": { "type": "object" },
        "source": { "type": "object" },
        "guestChecks": { "type": "object" },
        "finalPower": { "type": "string", "minLength": 1 },
        "failedStage": { "type": "string", "minLength": 1 },
        "failure": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
