{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machine-control.invalid/contracts/run-result-v0.schema.json",
  "title": "Machine Control Scoped Run Audit v0",
  "type": "object",
  "required": [
    "schema", "event", "logicalTarget", "claimId", "workspaceHandle",
    "renewals", "cleanup"
  ],
  "properties": {
    "schema": { "const": "machine-control-run/v0" },
    "event": { "enum": ["acquired", "finished"] },
    "logicalTarget": { "type": "string", "minLength": 1 },
    "claimId": { "type": ["string", "null"], "pattern": "^c-[a-f0-9]{24}$" },
    "workspaceHandle": {
      "type": ["string", "null"], "pattern": "^w-[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
    },
    "renewals": { "type": "integer", "minimum": 0 },
    "cleanup": {
      "type": "object",
      "required": ["claim", "workspace"],
      "properties": {
        "claim": { "$ref": "#/$defs/cleanup" },
        "workspace": { "$ref": "#/$defs/cleanup" }
      },
      "additionalProperties": false
    },
    "outcome": {
      "enum": ["completed", "child_failed", "interrupted", "renewal_failed", "setup_failed"]
    },
    "childExitCode": { "type": ["integer", "null"] },
    "signal": { "type": ["integer", "null"], "minimum": 1 },
    "errorCode": { "type": ["string", "null"] },
    "exitCode": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false,
  "allOf": [{
    "if": { "properties": { "event": { "const": "finished" } } },
    "then": { "required": ["outcome", "childExitCode", "signal", "errorCode", "exitCode"] }
  }],
  "$defs": {
    "cleanup": { "enum": ["not_acquired", "released", "unresolved"] }
  }
}
