{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://machine-control.invalid/contracts/targets-v0.schema.json",
  "title": "Machine Control Local Target Registry v0",
  "type": "object",
  "required": ["schema", "targets"],
  "properties": {
    "schema": { "const": "machine-control-targets/v0" },
    "includeDefaults": { "type": "boolean" },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "platform", "profile", "controllerPlatforms", "command"
        ],
        "properties": {
          "platform": {
            "enum": [
              "windows", "macos", "linux", "chromeos", "ios", "android", "quest",
              "steamdeck"
            ]
          },
          "profile": { "type": "string", "minLength": 1 },
          "interface": {
            "enum": ["machine-control-v0", "native"]
          },
          "controllerPlatforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["darwin", "linux", "windows"] }
          },
          "launcher": {
            "enum": ["auto", "direct", "python", "powershell", "bash"]
          },
          "workspaceDefaultIntent": {
            "enum": ["persistent", "isolated", "candidate"]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "environment": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
