{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machine Control CLI identity",
  "type": "object",
  "required": ["schema", "clientProtocol", "residentProtocol", "distribution", "version", "platform", "features"],
  "properties": {
    "schema": {"const": "machine-control-client-identity/v1"},
    "clientProtocol": {"const": 1},
    "residentProtocol": {"const": "machine-control/v0"},
    "distribution": {"enum": ["source", "desktop"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "platform": {"enum": ["macos", "darwin", "windows", "linux"]},
    "features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target": {"type": "string"},
    "command": {"type": "string"},
    "pythonVersion": {"type": "string"},
    "paths": {
      "description": "Optional --paths diagnostics computed at invocation; not signed receipt fields or live resident identity.",
      "type": "object",
      "required": ["cliRoot", "cliEntry", "interpreter", "launcher"],
      "properties": {
        "cliRoot": {"type": "string"},
        "cliEntry": {"type": "string"},
        "interpreter": {"type": "string"},
        "launcher": {"type": "string"},
        "installationRoot": {"type": "string"},
        "bundledResident": {"type": "string"}
      },
      "additionalProperties": false
    },
    "pythonArchiveSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [{"if": {"properties": {"distribution": {"const": "desktop"}}},
             "then": {"required": ["sourceRevision", "target", "command", "pythonVersion", "pythonArchiveSha256"]}}],
  "additionalProperties": false
}
