#!/usr/bin/env bash

set -euo pipefail

readonly PROVIDER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../../scripts/common.sh
source "$PROVIDER_DIR/../../scripts/common.sh"
readonly PORT="${1:-22}"
readonly CONNECT_TIMEOUT="$WINVM_BOOT_TIMEOUT"

"$WINVM_REPO_DIR/bin/winvm" assert-target connect >/dev/null
if [[ "$($WINVM_REPO_DIR/bin/winvm status)" == "stopped" ]]; then
    ip="$($WINVM_REPO_DIR/bin/winvm up)"
else
    ip="$($WINVM_REPO_DIR/bin/winvm ip)"
fi

deadline=$((SECONDS + CONNECT_TIMEOUT))
while (( SECONDS < deadline )); do
    if /usr/bin/nc -G 1 -z "$ip" "$PORT" >/dev/null 2>&1; then
        exec /usr/bin/nc "$ip" "$PORT"
    fi
    sleep 1
done

printf 'Timed out waiting for %s:%s\n' "$ip" "$PORT" >&2
exit 1
