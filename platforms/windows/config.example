# Copy this file to config.local only when the defaults do not match your VM.
# config.local is ignored by Git. Environment variables override these values.

WINVM_PROVIDER=utm-macos
# Linux-hosted native x86_64 route:
# WINVM_PROVIDER=libvirt-linux
# WINVM_LIBVIRT_URI=qemu:///system
# WINVM_LIBVIRT_DOMAIN_NAME=PRIVATE_DOMAIN_NAME
# WINVM_LIBVIRT_NETWORK=PRIVATE_NETWORK_NAME
# WINVM_LIBVIRT_POOL=PRIVATE_STORAGE_POOL
# WINVM_LIBVIRT_MIN_FREE_BYTES=68719476736
# WINVM_LIBVIRT_NVRAM_DIRECTORY=/var/lib/libvirt/qemu/nvram
# WINVM_LIBVIRT_NVRAM_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
WINVM_GUEST_DRIVER=windows
WINVM_UTM_NAME=Windows
# Used only by the explicit, UUID-checked UTM registration repair. The default
# is UTM's normal Documents location for WINVM_UTM_NAME.
# WINVM_UTM_BUNDLE="$HOME/Library/Containers/com.utmapp.UTM/Data/Documents/Windows.utm"
# Mutating commands fail closed until both values identify the configured VM.
# Obtain the UUID locally with: bin/winvm target-id
# Roles are source, candidate, or seal. Keep the real UUID in config.local.
WINVM_EXPECTED_UTM_ID=
WINVM_TARGET_ROLE=unclassified

# Source mutation and a persistent retained-seal boot are exceptional recovery
# actions. Prefer one-command environment overrides instead of storing these.
WINVM_ALLOW_SOURCE_MUTATION=0
WINVM_ALLOW_PERSISTENT_SEAL_BOOT=0
WINVM_UTMCTL=/Applications/UTM.app/Contents/MacOS/utmctl
# With UTM dynamic resolution, capture derives the current guest coordinate
# space from the console viewport. Set both dimensions only for a fixed guest
# resolution that does not follow the console size.
WINVM_DISPLAY_WIDTH=
WINVM_DISPLAY_HEIGHT=
WINVM_UTM_TITLEBAR_HEIGHT=40
WINVM_SSH_HOST=winvm
WINVM_SSH_PORT=22
# Windows update or recovery boots can legitimately take several minutes.
WINVM_BOOT_TIMEOUT=600
WINVM_SHUTDOWN_TIMEOUT=120
WINVM_GUEST_SHUTDOWN_GRACE=30
WINVM_POST_UPDATE_REPORT_TIMEOUT=45
# Bounds the single read-only guest probe used by target doctor.
WINVM_DOCTOR_GUEST_TIMEOUT=60
# Per portable/native guest process; the native three-project build can be slow.
WINVM_CERTIFY_CHECK_TIMEOUT=1200
# Override only when OpenSSH clients are not on PATH.
WINVM_SSH_BIN=ssh
WINVM_SCP_BIN=scp

# auto: report known UTM/QEMU blockers and use guest shutdown unless suspend is
# positively enabled. Use enabled only after validating suspend for the exact
# VM configuration; use disabled to declare a known provider limitation.
WINVM_SUSPEND_POLICY=auto

# Prohibit host UTM-window capture and input during ordinary acceptance.
WINVM_FORBID_OUTER_UI=false

# These normally do not need to change.
WINVM_UI_PIPE_NAME=winvm-ui
WINVM_UI_TASK_NAME='WinVM UI Relay'

# The ordinary target remains a stateful development VM. Workspace operations
# stay unavailable until exact development/ready-base identities are placed in
# ignored configuration and their controller readiness is explicitly proven.
WINVM_WORKSPACE_DEVELOPMENT_NAME=
# Claim records default to a private subdirectory of workspace state.
# WINVM_CLAIM_STATE_DIR=
WINVM_WORKSPACE_DEVELOPMENT_ID=
WINVM_WORKSPACE_DEVELOPMENT_PROVEN=false
WINVM_WORKSPACE_READY_BASE_NAME=
WINVM_WORKSPACE_READY_BASE_ID=
WINVM_WORKSPACE_READY_BASE_PROVEN=false
# Set true only when intentionally using the stopped development VM itself.
WINVM_WORKSPACE_ALLOW_SHARED_BASE=false
WINVM_WORKSPACE_STORAGE_PATH=
WINVM_WORKSPACE_MIN_FREE_BYTES=68719476736
WINVM_WORKSPACE_MAX_TEMPORARY=1
WINVM_WORKSPACE_MAX_RETAINED=2
WINVM_WORKSPACE_FULL_COPY_FALLBACK=prohibited
WINVM_WORKSPACE_CANDIDATE_PREFIX=machine-control-windows
