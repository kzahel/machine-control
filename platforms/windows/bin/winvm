#!/usr/bin/env bash

set -euo pipefail

readonly REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../scripts/common.sh
source "$REPO_DIR/scripts/common.sh"
# shellcheck source=../../../providers/claims/common.sh
source "$REPO_DIR/../../providers/claims/common.sh"

readonly WINVM_CLAIM_PROVIDER="$WINVM_PROVIDER-windows"

usage() {
    cat <<'EOF'
Usage: winvm COMMAND [ARG...]

Start here:
  host-doctor            Check the controller hypervisor without selecting a VM
  doctor [--json]        Check lifecycle, administration, desktop, and resident
  claim-capabilities | claim-status | claim-acquire | claim-check
  claim-renew | claim-release
                         Coordinate exclusive use of the exact pinned target
  candidate-status --json
                         Emit a minimized exact-candidate assertion
  repair-registration    Re-register the exact pinned on-disk UTM bundle
  up                     Start/resume the VM and print its current IPv4 address
  ssh [ARG...]           Connect using the configured SSH alias
  ui COMMAND [ARG...]    Inspect and control the Windows accessibility tree
  control JSON           Call the installed target-resident facade
  control-local JSON     Call the same installed guest-local CLI
  artifact ID [PATH]     Fetch one bounded resident capture artifact
  post-update audit|repair [--reboot]
                         Audit or restore bounded startup invariants
  appliance-certify     Reboot and run exact-source checks on the candidate

Setup:
  stage-bootstrap [KEY]  Stage OpenSSH bootstrap files through the provider
  trust-ssh-host-key     Trust the exact guest's SSH host key via QGA
  deploy-ui              Install WinApp and deploy/restart the session-1 relay
  ssh-config USER        Print the recommended OpenSSH client entry

UTM/macOS recovery:
  A claim acquired with --disruptive is required for these commands.
  screenshot [PATH]      Capture the visible UTM VM window to a PNG
  type TEXT              Type ASCII text through UTM input automation
  click X Y [BUTTON]     Click guest coordinates (left, right, or middle)
  key NAME               Send a common raw key/chord through UTM
  scan CODE...           Send decimal PC/AT scan codes through UTM

Image lifecycle:
  target-id              Print the configured VM's provider-native UUID
  pin-target ROLE [NAME] Pin a selected VM's UUID and source/candidate/seal role
  assert-target OP       Verify its ignored UUID pin, role, and operation policy
  seal NAME              Clone the configured stopped VM as a stopped seal
  disposable-up          Start the configured VM without persisting changes
  export-image PATH      Export the configured stopped VM to a new .utm bundle
  image-manifest PATH [--oobe-confirmed]
                         Write or refresh the adjacent private export manifest
  delete --confirm NAME  Delete the exact configured stopped VM
  workspace-capabilities | workspace-acquire | workspace-inventory
  workspace-release | workspace-gc

Image factory:
  factory-status --json  Read minimized first-logon factory progress via QGA
  factory-create NAME WINDOWS_ISO SEED_ISO [BOOT_IMAGE]
                         Create a stopped QEMU VM from explicit local media
  factory-detach-installer
                         Remove only the installer from a stopped candidate
  factory-detach-media   Remove all removable drives from a stopped candidate
  generalize [--check|--decrypt|--confirm-target]
  generalize --remove-appx EXACT_PACKAGE_NAME
                         Prepare or Sysprep/shut down a pinned candidate

Lifecycle and shells:
  status | capabilities | ip | down | suspend | shutdown | force-stop
  down                   Safely suspend or shut down according to capabilities
  capabilities [--json]  Report lifecycle support and the default down action
  ps [COMMAND...]        Run the command in the Windows PowerShell SSH shell
  wsl [ARG...]           Run wsl.exe through Windows SSH

Key names:
  enter escape tab win-r win-d ctrl-shift-escape alt-f4 ctrl-alt-delete

Configuration:
  Copy config.example to config.local, or set WINVM_* environment variables.
EOF
}

provider() {
    local provider_path
    provider_path="$(winvm_provider_path)"
    if [[ ! -x "$provider_path" ]]; then
        printf 'Provider is unavailable: %s\n' "$provider_path" >&2
        exit 1
    fi
    exec "$provider_path" "$@"
}

assert_target() {
    local operation="$1"
    "$REPO_DIR/providers/$WINVM_PROVIDER/provider.sh" \
        assert-target "$operation" >/dev/null
}

claim_command() {
    claim_adapter_main "$WINVM_CLAIM_STATE_DIR" "$WINVM_CLAIM_PROVIDER" \
        "$WINVM_EXPECTED_UTM_ID" "$command" "$@"
}

require_target_claim() {
    claim_require_tools || return
    claim_require_exact "$WINVM_CLAIM_STATE_DIR" "$WINVM_CLAIM_PROVIDER" \
        "$WINVM_EXPECTED_UTM_ID"
}

require_disruptive_target_claim() {
    claim_require_tools || return
    claim_require_disruptive_exact "$WINVM_CLAIM_STATE_DIR" \
        "$WINVM_CLAIM_PROVIDER" "$WINVM_EXPECTED_UTM_ID"
}

print_ssh_config() {
    if [[ $# -ne 1 ]]; then
        printf 'Usage: winvm ssh-config WINDOWS_USER\n' >&2
        return 2
    fi
    cat <<EOF
Host $WINVM_SSH_HOST
    HostName $WINVM_SSH_HOST
    User $1
    Port $WINVM_SSH_PORT
    HostKeyAlias $(winvm_ssh_host_key_alias)
    CheckHostIP no
    ProxyCommand $WINVM_REPO_DIR/providers/$WINVM_PROVIDER/ssh-proxy %p
    ServerAliveInterval 15
    ServerAliveCountMax 4
EOF
}

command="${1:-help}"
shift || true

case "$command" in
    help|-h|--help|host-doctor|doctor|status|capabilities|target-id|pin-target|factory-create|claim-*|ui|workspace-capabilities|workspace-inventory|workspace-gc) ;;
    workspace-acquire|workspace-release) ;;
    screenshot|type|click|key|scan) require_disruptive_target_claim ;;
    *) require_target_claim ;;
esac

case "$command" in
    help|-h|--help) usage ;;
    host-doctor) provider host-doctor ;;
    doctor)
        export MACHINE_CONTROL_CLAIM_POLICY=optional
        export WINVM_SSH_ALLOW_START=false
        if [[ "${1:-}" == "--json" ]]; then
            exec "$REPO_DIR/scripts/doctor-json.sh"
        fi
        assert_target connect
        exec "$REPO_DIR/scripts/doctor.sh" "$@"
        ;;
    candidate-status) exec "$REPO_DIR/scripts/candidate-status.sh" "$@" ;;
    claim-capabilities|claim-status|claim-acquire|claim-check|claim-renew|claim-release)
        claim_command "$@"
        ;;
    control|control-local)
        exec "$REPO_DIR/scripts/control.sh" "$@"
        ;;
    artifact)
        exec "$REPO_DIR/scripts/fetch-artifact.sh" "$@"
        ;;
    post-update) exec "$REPO_DIR/scripts/post-update.sh" "$@" ;;
    appliance-certify) exec "$REPO_DIR/scripts/certify-appliance.sh" "$@" ;;
    deploy-ui) assert_target deploy-ui; exec "$REPO_DIR/scripts/deploy-ui.sh" "$@" ;;
    stage-bootstrap) provider stage-bootstrap "$@" ;;
    ssh-config) print_ssh_config "$@" ;;
    ui) exec "$REPO_DIR/bin/winui" "$@" ;;
    ssh|ps) provider ssh-exec "$@" ;;
    wsl) provider ssh-exec wsl.exe "$@" ;;
    generalize) exec "$REPO_DIR/scripts/generalize-windows.sh" "$@" ;;
    image-manifest) exec "$REPO_DIR/scripts/image-manifest.sh" "$@" ;;
    workspace-capabilities|workspace-acquire|workspace-inventory|workspace-release|workspace-gc)
        exec "$REPO_DIR/providers/$WINVM_PROVIDER/workspace.sh" "$command" "$@"
        ;;
    status|capabilities|target-id|pin-target|assert-target|repair-registration|up|ip|screenshot|type|click|key|scan|down|suspend|shutdown|force-stop|seal|disposable-up|export-image|factory-status|factory-create|factory-detach-installer|factory-detach-media|trust-ssh-host-key|delete)
        provider "$command" "$@"
        ;;
    *)
        printf 'Unknown command: %s\n\n' "$command" >&2
        usage >&2
        exit 2
        ;;
esac
