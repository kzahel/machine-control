#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 5 || "$1" != "-" || "$3" != /* || "$4" != /* || "$5" != /* ]]; then
    printf 'Factory AppleScript did not receive absolute media paths.\n' >&2
    exit 1
fi

script="$(</dev/stdin)"
[[ "$script" == *'make new virtual machine'* ]]
mkdir -p "$WINVM_FACTORY_UTM_DIRECTORY/$2.utm/Data"
printf 'undersized store\n' >"$WINVM_FACTORY_UTM_DIRECTORY/$2.utm/Data/efi_vars.fd"
printf 'provider-private-object-identity\n'
