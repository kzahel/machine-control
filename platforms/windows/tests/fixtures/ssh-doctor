#!/usr/bin/env python3

import json
import os
import sys
import time


arguments = sys.argv[1:]
command = arguments[-1] if arguments else ""
if "[ScriptBlock]::Create" not in command:
    raise SystemExit(2)
if os.environ.get("WINVM_TEST_DOCTOR_HANG") == "1":
    time.sleep(5)

print(json.dumps({
    "explorerPresent": True,
    "status": {
        "schema": "machine-control/v0",
        "accepted": True,
        "sessionLocked": False,
        "desktop": "Default",
        "generation": "fixture-generation",
    },
    "nativeProvider": True,
}, separators=(",", ":")))
