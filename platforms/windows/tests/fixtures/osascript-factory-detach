#!/usr/bin/env bash

set -euo pipefail

script="$(</dev/stdin)"
if [[ "$script" == *'return id of targetVM'* ]]; then
    printf '11111111-2222-3333-4444-555555555555\n'
elif [[ "$script" == *'update configuration targetVM with vmConfig'* ]]; then
    printf '3\t0\n'
else
    printf 'Unexpected factory-detach AppleScript.\n' >&2
    exit 1
fi
