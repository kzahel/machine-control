#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
if [[ -f $REPO_ROOT/config.local ]]; then
    # shellcheck source=/dev/null
    source "$REPO_ROOT/config.local"
fi
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$REPO_ROOT/quest.py" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$REPO_ROOT/quest.py" "$@"
elif command -v py >/dev/null 2>&1; then
    exec py -3 "$REPO_ROOT/quest.py" "$@"
fi
echo "Python 3 was not found. Install Python 3.10 or later." >&2
exit 1
