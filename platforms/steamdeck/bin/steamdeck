#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
if [[ -f $REPO_ROOT/config.local ]]; then
    # shellcheck source=/dev/null
    source "$REPO_ROOT/config.local"
fi
exec python3 "$REPO_ROOT/steamdeck.py" "$@"
