#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

CONFIG_FILE="${IOS_DEVICE_TESTBED_CONFIG_FILE:-$REPO_ROOT/config.local}"
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

export IOS_DEVICE_TESTBED_ROOT="$REPO_ROOT"

if command -v python3 >/dev/null 2>&1; then
    exec python3 "$REPO_ROOT/ios_device.py" "$@"
fi

echo "Python 3 was not found. Install Python 3.10 or later." >&2
exit 1
