# Copy to config.local and change only machine-specific values.
LINUXVM_UTM_NAME=Linux
# Linux-hosted native x86_64 route:
# LINUXVM_PROVIDER=libvirt-linux
# LINUXVM_LIBVIRT_URI=qemu:///system
# LINUXVM_LIBVIRT_DOMAIN_NAME=PRIVATE_DOMAIN_NAME
# LINUXVM_LIBVIRT_NETWORK=PRIVATE_NETWORK_NAME
# LINUXVM_LIBVIRT_POOL=PRIVATE_STORAGE_POOL
# LINUXVM_LIBVIRT_MIN_FREE_BYTES=34359738368
# LINUXVM_LIBVIRT_NVRAM_DIRECTORY=/var/lib/libvirt/qemu/nvram
# LINUXVM_LIBVIRT_NVRAM_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
LINUXVM_DESKTOP_USER=
LINUXVM_DISPLAY_WIDTH=1280
LINUXVM_DISPLAY_HEIGHT=800
LINUXVM_BOOT_TIMEOUT=120
LINUXVM_SHUTDOWN_TIMEOUT=120
LINUXVM_EXEC_TIMEOUT=300
LINUXVM_REQUIRE_MUTATION_GUARD=true
LINUXVM_TARGET_ROLE=unspecified
LINUXVM_EXPECTED_NAME=
LINUXVM_EXPECTED_UUID=
LINUXVM_FORBID_OUTER_UI=false

# Workspace operations remain unavailable until exact guarded development and
# ready-base identities are supplied in ignored/private configuration.
LINUXVM_WORKSPACE_DEVELOPMENT_NAME=
# Claim records default to a private subdirectory of workspace state.
# LINUXVM_CLAIM_STATE_DIR=
LINUXVM_WORKSPACE_DEVELOPMENT_ID=
LINUXVM_WORKSPACE_DEVELOPMENT_PROVEN=false
LINUXVM_WORKSPACE_READY_BASE_NAME=
LINUXVM_WORKSPACE_READY_BASE_ID=
LINUXVM_WORKSPACE_READY_BASE_PROVEN=false
# Set true only when intentionally using the stopped development VM itself.
LINUXVM_WORKSPACE_ALLOW_SHARED_BASE=false
LINUXVM_WORKSPACE_STORAGE_PATH=
LINUXVM_WORKSPACE_MIN_FREE_BYTES=34359738368
LINUXVM_WORKSPACE_MAX_TEMPORARY=1
LINUXVM_WORKSPACE_MAX_RETAINED=2
LINUXVM_WORKSPACE_FULL_COPY_FALLBACK=prohibited
LINUXVM_WORKSPACE_CANDIDATE_PREFIX=machine-control-linux
