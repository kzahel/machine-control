#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
source "$root/providers/claims/common.sh"
backend="$root/platforms/macos/providers/qemu-linux/identity.py"
claim_dir="${XDG_STATE_HOME:-$HOME/.local/state}/machine-control/claims"
workspace_dir="${XDG_STATE_HOME:-$HOME/.local/state}/machine-control/macos-libvirt-workspaces"
provider=qemu-linux-macos
libvirt_core="$root/providers/libvirt-linux/libvirt_provider.py"
umask 077

command="${1:-help}"
shift || true
case "${MACVM_QEMU_PROVIDER:-quickemu}" in
    quickemu) ;;
    libvirt)
        provider=libvirt-linux-macos
        export MC_LIBVIRT_PROFILE=macos-intel
        source "$root/platforms/macos/providers/qemu-linux/libvirt.sh"
        macvm_libvirt_select_workspace
        ;;
    *) printf 'Unsupported macVM QEMU provider\n' >&2; exit 2 ;;
esac

vm_identity() {
    if [[ "$provider" == libvirt-linux-macos ]]; then
        "$libvirt_core" inspect >/dev/null || return
        printf '%s\n' "$MC_LIBVIRT_EXPECTED_UUID"
    else
        python3 "$backend" identity
    fi
}

vm_status() {
    if [[ "$provider" == libvirt-linux-macos ]]; then
        local state
        state="$("$libvirt_core" status)" || return
        case "$state" in
            started) printf 'running\n' ;;
            stopped) printf 'off\n' ;;
            *) printf '%s\n' "$state" ;;
        esac
    else
        python3 "$backend" status
    fi
}

resource="$(vm_identity 2>/dev/null || true)"
require_claim() {
    local result
    if [[ -z "$resource" || -z "${MACHINE_CONTROL_CLAIM_ID:-}" ]]; then
        printf 'A live exact-target claim is required\n' >&2
        return 1
    fi
    if ! result="$(claim_check_exact "$claim_dir" "$provider" "$resource" "$MACHINE_CONTROL_CLAIM_ID" "$@")"; then
        printf '%s\n' "$result" >&2
        return 1
    fi
}
ssh_select() {
    local address=127.0.0.1
    local -a host_key_alias=()
    if [[ "$provider" == libvirt-linux-macos ]]; then
        address="$("$libvirt_core" ip 2>/dev/null)" || return
        host_key_alias=(-o "HostKeyAlias=${MACVM_LIBVIRT_SSH_HOST_KEY_ALIAS:?}")
    fi
    ssh_base=(ssh -F /dev/null -T -o BatchMode=yes -o ConnectTimeout=5
        -o StrictHostKeyChecking=yes -o GlobalKnownHostsFile=/dev/null
        -o "UserKnownHostsFile=${MACVM_QEMU_KNOWN_HOSTS:-/dev/null}"
        -o IdentitiesOnly=yes -i "${MACVM_QEMU_SSH_KEY:-/dev/null}"
        -p "${MACVM_QEMU_SSH_PORT:-22}" -l "${MACVM_QEMU_SSH_USER:-guest}"
        "${host_key_alias[@]}" -- "$address")
}
remote_command() {
    python3 -c 'import shlex, sys; print(shlex.join(sys.argv[1:]))' \
        /usr/bin/env "MACHINE_CONTROL_CLAIM_ID=${MACHINE_CONTROL_CLAIM_ID:-}" "$@"
}

remote() {
    local command_line
    command_line="$(remote_command "$@")" || return
    "${ssh_base[@]}" "$command_line"
}

resident() {
    remote "${MACVM_QEMU_GUEST_PYTHON:?}" -I -B "${MACVM_QEMU_RESIDENT_ADAPTER:?}" "$@"
}

install_package() (
    [[ $# == 2 && -f "$1" && "$2" =~ ^[0-9a-f]{64}$ ]] || exit 2
    local digest stage
    digest="$(sha256sum <"$1" | awk '{print $1}')" || exit
    if [[ "$digest" != "$2" ]]; then
        printf 'Controller package digest mismatch\n' >&2
        exit 1
    fi
    stage="$(remote /usr/bin/mktemp -d /tmp/machine-control-package.XXXXXXXX)" || exit
    [[ "$stage" =~ ^/tmp/machine-control-package\.[A-Za-z0-9]+$ ]] || exit 1
    trap 'remote /bin/rm -f "$stage/package.dmg" && remote /bin/rmdir "$stage/mount" "$stage" 2>/dev/null || true' EXIT
    remote /bin/sh -c 'umask 077; /bin/cat >"$1"' sh "$stage/package.dmg" <"$1"
    remote /bin/bash -s -- "$stage" "$2" \
        <"$root/platforms/macos/providers/qemu-linux/install-package.sh"
)

probe_session() {
    local suffix=mc-cli/platforms/macos/host/machost.py probe command_line
    probe="${MACVM_QEMU_SESSION_PROBE:-}"
    if [[ -z "$probe" && "${MACVM_QEMU_RESIDENT_ADAPTER:-}" == */"$suffix" ]]; then
        probe="${MACVM_QEMU_RESIDENT_ADAPTER%"$suffix"}mc-session-probe"
    fi
    [[ -n "$probe" ]] || return 1
    command_line="$(remote_command "$probe")" || return
    timeout 5 "${ssh_base[@]}" "$command_line" </dev/null 2>/dev/null
}

fetch_artifact() {
    [[ $# == 1 || $# == 2 ]] || return 2
    local guest_copy directory output scratch status
    guest_copy="$(resident artifact-fetch "$1")" || return
    if [[ "$guest_copy" != /var/folders/*/machost-artifact.*/* &&
          "$guest_copy" != /private/var/folders/*/machost-artifact.*/* &&
          "$guest_copy" != /tmp/machost-artifact.*/* ]]; then
        printf 'Unexpected guest artifact staging path\n' >&2
        return 1
    fi
    if [[ $# == 2 ]]; then
        output="$2"
    else
        directory="$(mktemp -d)" || return
        output="$directory/${guest_copy##*/}"
    fi
    status=0
    scratch="$(mktemp -- "${output}.partial.XXXXXX")" || status=$?
    if [[ "$status" == 0 ]]; then
        remote /bin/cat "$guest_copy" >"$scratch" &&
            [[ -s "$scratch" ]] && mv -T -- "$scratch" "$output" || status=$?
        rm -f -- "$scratch"
    fi
    remote /bin/rm -f "$guest_copy" && remote /bin/rmdir "${guest_copy%/*}" || return
    [[ "$status" == 0 ]] || return "$status"
    printf '%s\n' "$output"
}

case "$command" in
    help|-h|--help)
        printf '%s\n' 'macvm-qemu status|doctor|bootstrap-stages|claim-*|up|shutdown' \
            'macvm-qemu exec|control|channel|artifact-fetch|install-package' \
            'macvm-qemu screenshot|click|key|type-secret|workspace-*'
        ;;
    claim-*)
        claim_adapter_main "$claim_dir" "$provider" "$resource" "$command" "$@"
        ;;
    workspace-*)
        [[ "$provider" == libvirt-linux-macos ]] || exit 2
        macvm_libvirt_workspaces "$command" "$@"
        ;;
    status)
        vm_status
        ;;
    doctor|bootstrap-stages)
        if [[ "$command" == bootstrap-stages ]]; then
            [[ "$*" == --json ]] || exit 2
            require_claim
        fi
        power=unknown identity=unavailable
        if [[ -n "$resource" ]]; then
            power="$(vm_status 2>/dev/null)" && identity=verified || power=unknown
        fi
        administration=unavailable
        resident_status= session_status=
        if [[ "$power" == running ]] && ssh_select && remote /usr/bin/true </dev/null 2>/dev/null; then
            administration=ready
            if [[ -n "${MACVM_QEMU_RESIDENT_ADAPTER:-}" && -n "${MACVM_QEMU_GUEST_PYTHON:-}" ]]; then
                status_command="$(remote_command "$MACVM_QEMU_GUEST_PYTHON" -I -B \
                    "$MACVM_QEMU_RESIDENT_ADAPTER" control '{"operation":"status"}')"
                resident_status="$(timeout 12 "${ssh_base[@]}" "$status_command" </dev/null 2>/dev/null || true)"
            fi
            if [[ -z "$resident_status" ]]; then
                session_status="$(probe_session || true)"
            fi
        fi
        export MACVM_QEMU_PROBE_POWER="$power" MACVM_QEMU_PROBE_IDENTITY="$identity" \
            MACVM_QEMU_PROBE_ADMINISTRATION="$administration" MACVM_QEMU_PROBE_RESIDENT="$resident_status" \
            MACVM_QEMU_PROBE_SESSION="$session_status" MACVM_QEMU_PROBE_PROVIDER="$provider"
        exec python3 "$root/platforms/macos/providers/qemu-linux/doctor.py" "$command"
        ;;
    screenshot|click|key)
        require_claim --required-use-class disruptive
        if [[ "$provider" == libvirt-linux-macos ]]; then
            exec python3 "$root/platforms/macos/providers/qemu-linux/libvirt_recovery.py" "$command" "$@"
        fi
        exec python3 "$backend" "$command" "$@"
        ;;
    type-secret)
        require_claim --required-use-class disruptive
        if [[ $# == 4 && "$1" == --observed-password-field &&
              "$3" == --observed-password-field ]]; then
            set -- "$2" "$4"
        elif [[ $# == 2 && "$1" == --observed-password-field ]]; then
            set -- "$2"
        else
            exit 2
        fi
        ssh_select
        observed="$(probe_session)" || exit
        if ! jq -e '.desktopState == "locked" or .desktopState == "no_session"' <<<"$observed" >/dev/null; then
            printf 'Stored login requires a verified locked or signed-out guest console\n' >&2
            exit 1
        fi
        if [[ "$provider" == libvirt-linux-macos ]]; then
            exec python3 "$root/platforms/macos/providers/qemu-linux/libvirt_recovery.py" type-secret "$@"
        fi
        exec python3 "$backend" type-secret "$@"
        ;;
    shutdown)
        require_claim
        [[ $# == 0 ]] || exit 2
        if [[ "$provider" == libvirt-linux-macos ]]; then
            macvm_libvirt_shutdown
            exit $?
        fi
        exec python3 "$backend" shutdown
        ;;
    up)
        require_claim
        [[ $# == 0 ]] || exit 2
        if [[ "$provider" == libvirt-linux-macos ]]; then
            if [[ "${MACVM_LIBVIRT_READY_BASE_PROVEN:-false}" == true &&
                  -z "${MACHINE_CONTROL_WORKSPACE_HANDLE:-}" ]]; then
                printf 'A sealed macOS base can only start through a derived workspace\n' >&2
                exit 1
            fi
            exec "$libvirt_core" start
        fi
        if [[ "$(uname -sm)" != "Linux x86_64" || ! -r /dev/kvm || ! -w /dev/kvm ]]; then
            printf 'Starting this appliance requires native x86_64 Linux and access to KVM\n' >&2
            exit 1
        fi
        exec 9>"${MACVM_QEMU_DIRECTORY:?}/.machine-control-lifecycle.lock"
        flock -n 9
        [[ "$(python3 "$backend" status)" == off ]] || exit 1
        "${MACVM_QEMU_LAUNCHER:?}" 9>&-
        for attempt in {1..20}; do
            state="$(python3 "$backend" status)" || exit
            [[ "$state" != running ]] || exit 0
            sleep 1
        done
        printf 'The launcher returned before the exact KVM target became reachable\n' >&2
        exit 1
        ;;
    exec|control|control-local|channel|artifact-fetch|install-package)
        require_claim
        [[ "$(vm_status)" == running ]] || exit 1
        ssh_select
        if [[ "$command" == exec ]]; then
            [[ $# -gt 0 ]] || exit 2
            remote "$@"
        elif [[ "$command" == channel ]]; then
            [[ $# == 0 ]] || exit 2
            status_command="$(remote_command "${MACVM_QEMU_GUEST_PYTHON:?}" -I -B \
                "${MACVM_QEMU_RESIDENT_ADAPTER:?}" channel)"
            MACHINE_CONTROL_CLAIM_POLICY=required claim_guard_channel "$claim_dir" "$provider" \
                "$resource" "${ssh_base[@]}" "$status_command"
        elif [[ "$command" == artifact-fetch ]]; then
            fetch_artifact "$@"
        elif [[ "$command" == install-package ]]; then
            install_package "$@"
        else
            resident "$command" "$@"
        fi
        ;;
    *)
        printf 'Unsupported macVM QEMU operation\n' >&2
        exit 2
        ;;
esac
