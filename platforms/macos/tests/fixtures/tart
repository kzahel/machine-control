#!/usr/bin/env bash

set -euo pipefail

case "${1:-}" in
    exec)
        shift 2
        exec "$@"
        ;;
    get)
        printf '{"State":"%s","Display":"1280x800"}\n' \
            "${MACHINE_CONTROL_TART_STATE:-stopped}"
        ;;
    list)
        if [[ "${MACHINE_CONTROL_TART_INVENTORY_UNAVAILABLE:-false}" == true ||
              ( "${MACHINE_CONTROL_TART_INVENTORY_FAIL_AFTER_MUTATION:-false}" == true &&
                -e "${MACHINE_CONTROL_TART_MUTATION_MARKER:?}" ) ]]; then
            printf '[]\n'
            exit 1
        fi
        printf '%s\n' "${MACHINE_CONTROL_TART_INVENTORY:-[]}"
        ;;
    run|stop|suspend|delete|clone)
        : >"${MACHINE_CONTROL_TART_MUTATION_MARKER:?}"
        ;;
    ip)
        if [[ "${MACHINE_CONTROL_TART_IP_UNAVAILABLE:-false}" == true ]]; then
            exit 1
        fi
        printf '%s\n' '192.0.2.1'
        ;;
    *)
        printf 'Unexpected fake Tart command: %s\n' "${1:-}" >&2
        exit 2
        ;;
esac
