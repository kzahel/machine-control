{
  "schema": "machine-control-targets/v0",
  "includeDefaults": true,
  "targets": {
    "another-linux": {
      "platform": "linux",
      "profile": "ubuntu-gnome-wayland",
      "controllerPlatforms": ["darwin"],
      "launcher": "direct",
      "command": ["./platforms/linux/bin/linuxvm"]
    },
    "development-chromeos": {
      "platform": "chromeos",
      "profile": "chromeos-developer-device",
      "interface": "native",
      "controllerPlatforms": ["darwin", "linux"],
      "launcher": "direct",
      "command": ["./platforms/chromeos/bin/chromeos"],
      "environment": {
        "CHROMEBOOK_HOST": "example-chromeos-device"
      }
    }
  }
}
