{
  "manifest_version": 3,
  "name": "Machine Control",
  "version": "0.4.0",
  "description": "Lets the Machine Control resident on this computer operate Chrome tabs when a person has granted browser access.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Machine Control"
  }
}
