{
  "manifest_version": 3,
  "name": "Machine Control",
  "version": "0.8.3",
  "description": "Lets AI agents use Chrome through the Machine Control app on this computer, only while you have granted browser access.",
  "key": "",
  "minimum_chrome_version": "116",
  "homepage_url": "https://machinecontrol.dev/",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "favicon",
    "storage",
    "nativeMessaging",
    "alarms",
    "sidePanel"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Machine Control",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
