<domain type="kvm" xmlns:qemu="http://libvirt.org/schemas/domain/qemu/1.0">
  <name>fixture-macos</name>
  <uuid>11111111-2222-4333-8444-555555555555</uuid>
  <os>
    <type arch="x86_64" machine="pc-q35-8.2">hvm</type>
    <loader readonly="yes" type="pflash">/example/code.fd</loader>
    <nvram>/example/vars.fd</nvram>
  </os>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2"/><source file="/example/opencore.qcow2"/>
      <target dev="sda" bus="sata"/><boot order="1"/>
    </disk>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2"/><source file="/example/system.qcow2"/>
      <target dev="vda" bus="virtio"/><address type="pci" slot="0x03"/>
    </disk>
    <interface type="network">
      <source network="default"/><model type="virtio"/>
    </interface>
  </devices>
  <qemu:commandline>
    <qemu:arg value="-device"/><qemu:arg value="isa-applesmc,osk=fixture-value"/>
    <qemu:arg value="-cpu"/><qemu:arg value="Haswell-v2,vendor=GenuineIntel,+invtsc"/>
  </qemu:commandline>
</domain>
