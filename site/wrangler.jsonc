{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "machine-control-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "machinecontrol.dev",
			"custom_domain": true
		},
		{
			"pattern": "www.machinecontrol.dev",
			"custom_domain": true
		}
	],
	"vars": {
		"TURNSTILE_SITE_KEY": "0x4AAAAAAEbiufLao7TLs8db"
	},
	"d1_databases": [
		{
			"binding": "SIGNUPS",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
