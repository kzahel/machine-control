---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import appScreenshot from "../../../docs/images/desktop-access-macos.png";
import "../styles/product.css";

const title = "Machine Control — Your agent. Your devices. Your control.";
const description =
  "Give your choice of AI agent desktop and browser control on a physical computer or VM. Install for Mac, Windows, or Linux, and reach real iPhones, Chromebooks, and other devices.";
---

<SiteLayout title={title} description={description} canonicalPath="/" image={appScreenshot.src}>
  <SiteHeader />
  <main class="product-page">
    <section class="hero product-hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Desktop app · real devices · your choice of agent</p>
          <h1>Let AI agents use your computers and devices.</h1>
          <p class="lede">
            Install Machine Control on a Mac, Windows PC, or Linux computer—physical
            or virtual. Give agents access to apps, browser tabs, screenshots,
            keyboard, and mouse, with controls you can see and stop.
          </p>
          <p class="hero-device-note">
            Reach real iPhones, Chromebooks, Android devices, and more through
            their native control routes.
          </p>
          <div class="actions">
            <a class="button button-primary" href="/downloads/">Download for Mac, Windows &amp; Linux</a>
            <a class="button button-secondary" href="#targets">Explore devices ↓</a>
          </div>
          <ul class="proof-list" aria-label="Product facts">
            <li>Open source</li>
            <li>Provider independent</li>
            <li>Physical computers and VMs</li>
          </ul>
        </div>
        <figure class="product-screenshot">
          <img
            src={appScreenshot.src}
            width={appScreenshot.width}
            height={appScreenshot.height}
            alt="Machine Control on macOS, showing access scopes, Pause access, and the Permissions, Activity, and Settings tabs."
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>The Mac app. Choose access scopes and pause control at any time.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section" id="features">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Why Machine Control</p>
          <h2>Your choice of agent. Your whole desktop.</h2>
          <p>
            Use an OpenAI or Anthropic agent, another provider, or your own.
            Any agent that can run commands can use Machine Control's CLI.
            You choose the agent, the machine, and the access.
          </p>
        </div>
        <div class="product-feature-grid">
          <article class="product-card">
            <span class="product-card-label">Desktop</span>
            <h3>Full desktop control</h3>
            <p>Work across applications and system UI. Agents can read UI elements,
              operate controls, enter text, and capture the screen using the
              platform's native capabilities and your selected permissions.</p>
          </article>
          <article class="product-card">
            <span class="product-card-label">Browser</span>
            <h3>Native browser control</h3>
            <p>Control existing Chrome tabs, including signed-in sites, through
              the optional extension. Grant browser access separately from
              scripts and DevTools for deeper automation.</p>
            <a class="text-link" href="https://github.com/kzahel/machine-control/blob/main/topics/browser-control.md">Browser setup and capabilities →</a>
          </article>
          <article class="product-card">
            <span class="product-card-label">Permission</span>
            <h3>Ask first. Work on your terms.</h3>
            <p>Agents can request permission in a native prompt. Choose scopes
              and duration, and turn access off at any time. On Mac and Windows,
              pause access while you work and resume when you're ready.</p>
          </article>
          <article class="product-card">
            <span class="product-card-label">Locked screen</span>
            <h3>Keep working while you're away</h3>
            <p>Opt in to approved tasks on an awake computer while its screen is
              locked. Mac and Windows profiles use covered control and task-end
              relock, with additional helper setup and platform requirements.</p>
            <div class="product-card-links">
              <a href="https://github.com/kzahel/machine-control/blob/main/platforms/macos/docs/locked-use.md">Mac setup</a>
              <a href="https://github.com/kzahel/machine-control/blob/main/desktop/WINDOWS-LOCKED-USE.md">Windows setup</a>
            </div>
          </article>
        </div>
        <p class="product-scope-note">
          Capabilities vary by platform. Locked-screen profiles are opt-in and
          experimental; Linux currently targets Ubuntu GNOME Wayland.
          <a href="https://github.com/kzahel/machine-control/blob/main/docs/desktop-acceptance.md">See feature and testing coverage</a>.
        </p>
      </div>
    </section>

    <section class="section section-white" id="desktop">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Install where the work happens</p>
          <h2>Your computer. A test VM. A remote machine.</h2>
          <p>
            Install the desktop app on a physical computer or inside a VM.
            It runs in the menu bar or tray and includes the control CLI.
            Configured remote targets use the same native controls.
          </p>
        </div>
        <div class="product-platform-grid">
          <article class="product-card product-platform">
            <h3>macOS</h3>
            <p>Apple silicon and Intel.<br />Menu bar app with native permissions.</p>
            <a class="button button-secondary" href="/downloads/#mac-download">Download for Mac</a>
          </article>
          <article class="product-card product-platform">
            <h3>Windows</h3>
            <p>Intel / AMD x64 and ARM64.<br />Tray app with visible access controls.</p>
            <a class="button button-secondary" href="/downloads/#windows-download">Download for Windows</a>
          </article>
          <article class="product-card product-platform">
            <h3>Linux</h3>
            <p>Ubuntu GNOME Wayland, x64 and ARM64.<br />Debian and AppImage packages.</p>
            <a class="button button-secondary" href="/downloads/#linux-download">Download for Linux</a>
          </article>
        </div>
        <p class="product-scope-note">
          VM control runs inside the guest, so ordinary tasks don't need to focus
          a hypervisor window on your desktop. Remote access requires a configured,
          authenticated route. <a href="https://github.com/kzahel/machine-control/blob/main/docs/controller-host-support.md">VM and remote setup</a>
        </p>
      </div>
    </section>

    <section class="section" id="targets">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Real devices, too</p>
          <h2>Reach beyond the desktop.</h2>
          <p>
            Let the same agent work with real phones, Chromebooks, headsets,
            and handhelds. Each uses its native controls and device-specific setup.
          </p>
        </div>
        <div class="product-device-grid">
          <article class="product-card product-device" id="ios">
            <span class="product-card-label">Physical iOS</span>
            <h3>A real iPhone, in your workflow</h3>
            <p>Install and launch apps, inspect and act on the real UI, take
              screenshots, and collect app logs, system logs, crash reports,
              and test files.</p>
            <p class="product-card-detail">Uses an authorized Mac with pairing,
              Developer Mode, and a signed XCTest runner. Protected authentication
              stays on the device.</p>
            <a class="text-link" href="https://github.com/kzahel/machine-control/tree/main/platforms/ios">Set up iPhone control →</a>
          </article>
          <article class="product-card product-device" id="chromeos">
            <span class="product-card-label">ChromeOS</span>
            <h3>The Chromebook desktop, connected</h3>
            <p>Operate desktop controls and browser tabs, capture screenshots,
              send keyboard and pointer input, and deploy software—all through
              controls running on the Chromebook.</p>
            <p class="product-card-detail">Uses a dedicated developer-mode
              Chromebook and configured remote access.</p>
            <a class="text-link" href="https://github.com/kzahel/machine-control/tree/main/platforms/chromeos">Set up Chromebook control →</a>
          </article>
        </div>
        <div class="product-other-devices" aria-label="Other native device routes">
          <a href="https://github.com/kzahel/machine-control/tree/main/platforms/android"><strong>Android</strong><span>Deploy apps, capture, input, and logs</span></a>
          <a href="https://github.com/kzahel/machine-control/tree/main/platforms/quest"><strong>Quest</strong><span>Device selection, deployment, and lifecycle</span></a>
          <a href="https://github.com/kzahel/machine-control/tree/main/platforms/steamdeck"><strong>Steam Deck</strong><span>Administration and native session operations</span></a>
        </div>
      </div>
    </section>

    <section class="section section-ink" id="get-started">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Start with the app</p>
          <h2>Install. Choose access. Connect your agent.</h2>
          <p>Keep access off until you're ready. Approve an agent's request or
            enable the scopes you want, for a timed session or until you turn it off.</p>
        </div>
        <ol class="product-steps">
          <li><span>01</span><strong>Install the app</strong><p>Download for your computer or VM and open Machine Control.</p></li>
          <li><span>02</span><strong>Enable permissions</strong><p>Follow Permissions for desktop access and optional Chrome setup.</p></li>
          <li><span>03</span><strong>Give your agent a task</strong><p>Point it to the installed CLI and approve the access it needs.</p></li>
        </ol>
        <div class="actions">
          <a class="button button-on-dark" href="/getting-started/">Installation and agent handoff →</a>
        </div>
      </div>
    </section>

    <section class="section section-white" id="automation">
      <div class="shell product-automation">
        <div>
          <p class="eyebrow">For developers and automation</p>
          <h2>A desktop app with a CLI underneath.</h2>
          <p>Use the bundled CLI from your agent, terminal, or scripts.
            Headless deployments, remote targets, and isolated VM workspaces
            have focused guides.</p>
          <div class="product-card-links">
            <a href="https://github.com/kzahel/machine-control/blob/main/docs/cli-guide.md">CLI guide</a>
            <a href="https://github.com/kzahel/machine-control/tree/main/platforms">Platform guides</a>
            <a href="https://github.com/kzahel/machine-control/blob/main/topics/architecture.md">Architecture</a>
            <a href="/compare/">Compare tools</a>
          </div>
        </div>
        <aside class="product-origin">
          <h3>Built for real software</h3>
          <p>Developed at <a href="https://graehlarts.com">Graehl Arts</a> for
            applications that span desktop, browser, and physical devices.</p>
          <p><a href="https://jstorrent.com">JSTorrent</a> ·
            <a href="https://github.com/kzahel/rstorrent">RSTorrent</a> ·
            <a href="https://at-piano.com">Atpiano</a> ·
            <a href="https://ok200.app">200 OK Web Server</a></p>
          <a class="text-link" href="/blog/from-chromeos-testbed-to-agent-native-development/">How it started on a Chromebook →</a>
        </aside>
      </div>
    </section>

    <section class="section newsletter-section" id="newsletter">
      <div class="shell newsletter-grid">
        <div>
          <p class="eyebrow">Occasional updates</p>
          <h2>Follow the app and device work.</h2>
          <p>New releases, platform improvements, and useful agent workflows.</p>
        </div>
        <NewsletterSignup source="homepage" />
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
